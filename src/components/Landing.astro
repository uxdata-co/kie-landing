---
import MaskedHeading from "./MaskedHeading";
import Icon from "./Icon.astro";
import Terminal from "./Terminal.astro";
import AudienceToggle from "./AudienceToggle.astro";
import { guardTerminal, heroTerminal } from "./terminals";
import { REPO, localePath, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const docsHref = localePath(lang, "/docs");
const home = localePath(lang);
const TUT_AGENTS = ["claude", "codex", "cursor", "gemini", "desktop"] as const;
const ICON: Record<string, string> = { claude: "claude", codex: "openai", cursor: "cursor", gemini: "gemini", desktop: "claude" };
const code = (x: string) => x.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<!-- ============================================================ HERO -->
<section class="hero" id="top">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{s.hero.eyebrow}</p>
        <MaskedHeading
          client:load
          tag="h1"
          text={s.hero.headline}
          src="/mask.svg"
          align="left"
          weight={700}
          tracking={-0.04}
          lineHeight={1.0}
          textScale={0.105}
          reveal="rise"
          trigger="mount"
          parallax={22}
          drift={14}
          fillScale={1.3}
          className="hero-title"
        />
        <p class="lead">{s.hero.sub}</p>
        <AudienceToggle lang={lang} />
        <a href={`${home}#tutorials`} class="chat-link">
          <span class="chat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          {s.hero.ctaSecondary}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-term reveal in">
        <Terminal title={s.hero.terminalTitle} html={heroTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ WORKS WITH -->
<section class="trust">
  <div class="rails">
    <p class="eyebrow works-label">{s.agents.label}</p>
    <div class="grid trust-grid">
      {s.agents.items.map((a) => (
        <a class="stat agent reveal" href={`${docsHref}#skill`}>
          <Icon name={a.icon as "openai"} size={34} class="agent-icon" />
          <span class="agent-name">{a.name}</span>
          <span class="lbl mono">{a.hint}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ WHY -->
<section id="why" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.why.eyebrow}</p>
      <h2>{s.why.title}</h2>
      <p class="lead">{s.why.lead}</p>
    </div>
    <div class="grid why-grid" style="margin-top:56px">
      {s.why.cards.map((c, i) => (
        <article class="card reveal" style={`transition-delay:${i * 60}ms`}>
          <span class="idx">0{i + 1}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ INSTALL -->
<section id="install" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.install.eyebrow}</p>
        <h2>{s.install.title}</h2>
      </div>
      <ol class="steps">
        {s.install.steps.map((st, i) => (
          <li class="step reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="idx">0{i + 1}</span>
            <div>
              <h3>{st.t}</h3>
              <p class="muted" set:html={code(st.d)} />
              <pre class="code"><code>{st.code}</code></pre>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ============================================================ TUTORIALS -->
<section id="tutorials" class="section-pad tutorials">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.tutorials.eyebrow}</p>
      <h2>{s.tutorials.title}</h2>
      <p class="lead">{s.tutorials.lead}</p>
    </div>

    <div class="agent-tabs reveal" data-tabs>
      <div class="tablist" role="tablist">
        {TUT_AGENTS.map((k, i) => (
          <button role="tab" id={`tut-tab-${k}`} aria-controls={`tut-panel-${k}`} aria-selected={i === 0 ? "true" : "false"} type="button">
            <Icon name={ICON[k] as "openai"} size={18} class="tab-icon" />
            {s.tutorials.tabs[k].label}
          </button>
        ))}
      </div>
      {TUT_AGENTS.map((k, i) => {
        const tab = s.tutorials.tabs[k];
        return (
          <div role="tabpanel" id={`tut-panel-${k}`} aria-labelledby={`tut-tab-${k}`} hidden={i !== 0} class="agent-panel">
            <ol class="tut-steps">
              {tab.steps.map((st, j) => (
                <li><span class="n">{j + 1}</span><p set:html={code(st)} /></li>
              ))}
            </ol>
            <div class="chat">
              <div class="bubble user"><span class="who">you</span>{tab.prompt}</div>
              <div class="bubble agent">
                <span class="who">{tab.label}</span>
                <div class="ran">
                  {tab.cmds.map((c) => <code>$ {c}</code>)}
                </div>
                {tab.reply}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="tut-rules reveal">
      <h3 class="sub">{s.tutorials.rules.title}</h3>
      <ul class="rules two">
        {s.tutorials.rules.items.map((r) => <li><span class="chk">✕</span><span set:html={code(r)} /></li>)}
      </ul>
      <p class="muted small"><code>{s.tutorials.rules.budget}</code></p>
    </div>
  </div>
</section>

<!-- ============================================================ SPEND GUARD -->
<section id="guard" class="section-pad guard">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.guard.eyebrow}</p>
        <h2>{s.guard.title}</h2>
        <p class="lead">{s.guard.lead}</p>
      </div>
      <div class="checks">
        {s.guard.checks.map((c, i) => (
          <div class="check reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="n">{c.n}</span>
            <div>
              <h3>{c.t}</h3>
              <p class="muted" set:html={code(c.d)} />
            </div>
          </div>
        ))}
        <Terminal title="exit 3" class="reveal guard-term" html={guardTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ DOCS -->
<section id="docs" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="docs-band reveal">
      <div>
        <p class="eyebrow">{s.docsCta.eyebrow}</p>
        <h2>{s.docsCta.title}</h2>
        <p class="lead">{s.docsCta.teaser}</p>
      </div>
      <a class="btn btn-primary" href={docsHref}>{s.docsCta.cta} →</a>
    </div>
  </div>
</section>

<!-- ============================================================ FAQ -->
<section id="faq" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <p class="eyebrow reveal">{s.faq.eyebrow}</p>
    <div class="faq">
      {s.faq.items.map((it) => (
        <details class="reveal">
          <summary>{it.q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ CTA -->
<section class="cta">
  <div class="rails cta-inner">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="cta-head">
    <MaskedHeading
      client:load
      tag="h2"
      text={s.cta.title}
      src="/mask.svg"
      align="center"
      weight={700}
      tracking={-0.04}
      lineHeight={1.02}
      textScale={0.09}
      reveal="rise"
      trigger="view"
      parallax={18}
      drift={12}
      className="cta-title"
    />
    </div>
    <p class="lead center">{s.cta.sub}</p>
    <a href={REPO} class="btn btn-brand" target="_blank" rel="noopener">{s.cta.button} →</a>
  </div>
</section>

<style>
  /* hero */
  .hero {
    border-top: 0;
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 75% -10%, rgba(0, 168, 255, 0.14), transparent 60%),
      radial-gradient(600px 400px at 10% 110%, rgba(30, 64, 216, 0.12), transparent 60%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 128px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  :global(.hero-title) {
    margin: 0 0 24px !important;
    width: 100%;
  }
  .hero-copy {
    min-width: 0;
    max-width: 640px;
  }
  .hero-term {
    min-width: 0;
  }
  .cmd {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 8px 8px 8px 14px;
  }
  .cmd code {
    font-size: 12.5px;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .chat-link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }
  .chat-link:hover {
    color: var(--brand);
  }
  .chat-link .arrow {
    transition: transform 0.18s ease;
  }
  .chat-link:hover .arrow {
    transform: translateX(3px);
  }
  .chat-dots {
    display: inline-flex;
    gap: 3px;
  }
  .chat-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--brand);
    animation: chat-blink 1.4s infinite ease-in-out;
  }
  .chat-dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .chat-dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes chat-blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-dots i {
      animation: none;
      opacity: 1;
    }
  }
  .hero-term {
    transform: perspective(1400px) rotateY(-4deg);
    transition: transform 0.6s ease;
  }
  .hero-term:hover {
    transform: perspective(1400px) rotateY(0deg);
  }
  @media (max-width: 980px) {
    .hero-term {
      transform: none;
    }
  }

  /* trust */
  .trust-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 800px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .works-label {
    margin: 18px 0 0;
  }
  .stat {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .agent {
    transition: background 0.2s ease;
  }
  .agent:hover {
    background: var(--bg-raised);
  }
  .agent-icon {
    width: 34px;
    height: 34px;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .agent-name {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .tab-icon {
    width: 18px;
    height: 18px;
  }
  .lbl {
    font-size: 14px;
    color: var(--fg-muted);
  }

  /* why */
  .why-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1040px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  /* install */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step p {
    margin: 6px 0 14px;
    font-size: 15px;
  }
  .step code:not(pre code) {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  /* tabs (shared) */
  .tablist {
    display: flex;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .tablist button {
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--line);
    color: var(--fg-muted);
    font: 500 13.5px var(--font-sans);
    padding: 14px 20px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tablist button[aria-selected="true"] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  /* tutorials */
  .tutorials {
    background:
      radial-gradient(700px 360px at 90% 0%, rgba(0, 168, 255, 0.08), transparent 60%),
      var(--bg);
  }
  .small {
    font-size: 14px;
    margin: 14px 0 0;
  }
  .small code {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .agent-tabs {
    margin-top: 40px;
    border: 1px solid var(--line);
    background: var(--bg-card);
  }
  .agent-tabs .tablist button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    padding: 16px 24px;
  }
  .agent-panel[hidden] {
    display: none;
  }
  .agent-panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 0;
  }
  @media (max-width: 900px) {
    .agent-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .tut-steps {
    list-style: none;
    margin: 0;
    padding: 28px 28px 28px 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-content: start;
  }
  @media (max-width: 900px) {
    .tut-steps {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  .tut-steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    font-size: 15px;
    color: var(--fg-muted);
  }
  .tut-steps p {
    margin: 0;
  }
  .tut-steps code {
    color: var(--fg);
    background: var(--bg-raised);
    padding: 0 5px;
    border-radius: 4px;
    border: 1px solid var(--line);
    font-size: 12.5px;
  }
  .tut-steps .n {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--brand);
  }
  .chat {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background:
      radial-gradient(500px 240px at 100% 0%, rgba(30, 64, 216, 0.12), transparent 60%);
  }
  .bubble {
    max-width: 92%;
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.5;
    border: 1px solid var(--line);
    position: relative;
  }
  .bubble .who {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 6px;
  }
  .bubble.user {
    align-self: flex-end;
    background: var(--brand-soft);
    border-color: rgba(0, 168, 255, 0.35);
    border-bottom-right-radius: 4px;
  }
  .bubble.agent {
    align-self: flex-start;
    background: var(--bg-raised);
    border-bottom-left-radius: 4px;
  }
  .ran {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 0 12px;
    padding: 10px 12px;
    border-radius: 6px;
    background: #0a0a0d;
    border: 1px solid var(--line);
  }
  .ran code {
    font-size: 12px;
    color: var(--fg-muted);
    /* Wrap long invocations: a sideways scrollbar hides the end of the command. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 12px;
    text-indent: -12px;
  }
  .tut-rules {
    margin-top: 40px;
  }
  .rules.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
  }
  @media (max-width: 800px) {
    .rules.two {
      grid-template-columns: 1fr;
    }
  }
  .rules.two li {
    font-size: 15px;
    padding: 14px 0;
  }
  .rules.two li:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }
  .rules code {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
    font-size: 13px;
  }

  /* guard */
  .guard-term {
    margin-top: 28px;
  }
  .checks {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .check {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 8px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .check:nth-last-child(2) {
    border-bottom: 1px solid var(--line);
  }
  .check .n {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 13px;
    padding-top: 4px;
  }
  .check p {
    margin: 6px 0 0;
    font-size: 15px;
  }
  .check code {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
    font-size: 13px;
  }

  /* docs band */
  .docs-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .docs-band .lead {
    max-width: 60ch;
    margin-bottom: 0;
  }
  .sub {
    margin-bottom: 14px;
    font-size: 16px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  /* rules */
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rules li {
    display: flex;
    gap: 14px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
  }
  .rules li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .chk {
    color: var(--fg-dim);
    font-family: var(--font-mono);
  }

  /* faq */
  .faq {
    margin-top: 8px;
    border-top: 1px solid var(--line);
    max-width: 860px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    font-weight: 560;
    font-size: 17px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    transition: transform 0.2s ease;
  }
  details[open] .plus {
    transform: rotate(45deg);
    color: var(--brand);
  }
  details p {
    margin: -6px 0 22px;
    color: var(--fg-muted);
    max-width: 70ch;
  }

  /* cta */
  .cta {
    /* The masked heading paints a parallax layer wider than its box; clip it
       so the page never gains a horizontal scrollbar on narrow viewports. */
    overflow: clip;
    background:
      radial-gradient(800px 400px at 50% 120%, rgba(0, 168, 255, 0.18), transparent 65%),
      var(--bg);
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(80px, 11vw, 150px);
    gap: 8px;
  }
  .cta-head {
    width: 100%;
    max-width: 960px;
  }
  .center {
    text-align: center;
    margin-bottom: 28px;
  }
</style>
