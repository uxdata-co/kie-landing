---
import MaskedHeading from "./MaskedHeading";
import Icon from "./Icon.astro";
import Terminal from "./Terminal.astro";
import AudienceToggle from "./AudienceToggle.astro";
import { guardTerminal, heroTerminal } from "./terminals";
import { REPO, AFFILIATE, localePath, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const docsHref = localePath(lang, "/docs");
const home = localePath(lang);
const TUT_AGENTS = ["claude", "codex", "cursor", "gemini", "desktop"] as const;
const ICON: Record<string, string> = { claude: "claude", codex: "openai", cursor: "cursor", gemini: "gemini", desktop: "claude" };
const code = (x: string) => x.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<!-- ============================================================ HERO -->
<section class="hero" id="top">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{s.hero.eyebrow}</p>
        <MaskedHeading
          client:load
          tag="h1"
          text={s.hero.headline}
          src="/mask.svg"
          align="left"
          weight={700}
          tracking={-0.04}
          lineHeight={1.0}
          textScale={0.105}
          reveal="rise"
          trigger="mount"
          parallax={22}
          drift={14}
          fillScale={1.3}
          className="hero-title"
        />
        <p class="lead">{s.hero.sub}</p>
        <AudienceToggle lang={lang} />
        <a href={`${home}#tutorials`} class="chat-link">
          <span class="chat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          {s.hero.ctaSecondary}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-term reveal in">
        <Terminal title={s.hero.terminalTitle} html={heroTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ WORKS WITH -->
<section class="trust">
  <div class="rails">
    <p class="eyebrow works-label">{s.agents.label}</p>
    <div class="grid trust-grid">
      {s.agents.items.map((a) => (
        <a class="stat agent reveal" href={`${docsHref}#skill`}>
          <Icon name={a.icon as "openai"} size={34} class="agent-icon" />
          <span class="agent-name">{a.name}</span>
          <span class="lbl mono">{a.hint}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ AFFILIATE -->
<section class="affiliate" id="kie-ai">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="aff-card reveal">
      <div class="aff-bg" aria-hidden="true">
        <img src="/kie-hero.webp" alt="" width="1500" height="1461" loading="lazy" decoding="async" />
      </div>
      <div class="aff-copy">
        <p class="eyebrow">{s.affiliate.eyebrow}</p>
        <h2 class="aff-title">{s.affiliate.title}</h2>
        <p class="lead">{s.affiliate.lead}</p>
        <ul class="aff-stats">
          {s.affiliate.stats.map((st) => (
            <li>
              <span class="aff-v">{st.v}</span>
              <span class="lbl mono">{st.k}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="aff-action">
        <a href={AFFILIATE} class="btn btn-brand aff-btn" target="_blank" rel="sponsored noopener">{s.affiliate.cta}</a>
        <p class="aff-note">{s.affiliate.note}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ WHY -->
<section id="why" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.why.eyebrow}</p>
      <h2>{s.why.title}</h2>
      <p class="lead">{s.why.lead}</p>
    </div>
    <div class="grid why-grid" style="margin-top:56px">
      {s.why.cards.map((c, i) => (
        <article class="card reveal" style={`transition-delay:${i * 60}ms`}>
          <span class="idx">0{i + 1}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ INSTALL -->
<section id="install" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.install.eyebrow}</p>
        <h2>{s.install.title}</h2>
      </div>
      <ol class="steps">
        {s.install.steps.map((st, i) => (
          <li class="step reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="idx">0{i + 1}</span>
            <div>
              <h3>{st.t}</h3>
              <p class="muted" set:html={code(st.d)} />
              <pre class="code"><code>{st.code}</code></pre>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ============================================================ TUTORIALS -->
<section id="tutorials" class="section-pad tutorials">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.tutorials.eyebrow}</p>
      <h2>{s.tutorials.title}</h2>
      <p class="lead">{s.tutorials.lead}</p>
    </div>

    <div class="agent-tabs reveal" data-tabs>
      <div class="tablist" role="tablist">
        {TUT_AGENTS.map((k, i) => (
          <button role="tab" id={`tut-tab-${k}`} aria-controls={`tut-panel-${k}`} aria-selected={i === 0 ? "true" : "false"} type="button">
            <Icon name={ICON[k] as "openai"} size={18} class="tab-icon" />
            {s.tutorials.tabs[k].label}
          </button>
        ))}
      </div>
      {TUT_AGENTS.map((k, i) => {
        const tab = s.tutorials.tabs[k];
        return (
          <div role="tabpanel" id={`tut-panel-${k}`} aria-labelledby={`tut-tab-${k}`} hidden={i !== 0} class="agent-panel">
            <ol class="tut-steps">
              {tab.steps.map((st, j) => (
                <li><span class="n">{j + 1}</span><p set:html={code(st)} /></li>
              ))}
            </ol>
            <div class="chat">
              <div class="bubble user"><span class="who">you</span>{tab.prompt}</div>
              <div class="bubble agent">
                <span class="who">{tab.label}</span>
                <div class="ran">
                  {tab.cmds.map((c) => <code>$ {c}</code>)}
                </div>
                {tab.reply}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="tut-rules reveal">
      <h3 class="sub">{s.tutorials.rules.title}</h3>
      <ul class="rules two">
        {s.tutorials.rules.items.map((r) => <li><span class="chk">✕</span><span set:html={code(r)} /></li>)}
      </ul>
      <p class="muted small"><code>{s.tutorials.rules.budget}</code></p>
    </div>
  </div>
</section>

<!-- ============================================================ SPEND GUARD -->
<section id="guard" class="section-pad guard">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.guard.eyebrow}</p>
        <h2>{s.guard.title}</h2>
        <p class="lead">{s.guard.lead}</p>
      </div>
      <div class="checks">
        {s.guard.checks.map((c, i) => (
          <div class="check reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="n">{c.n}</span>
            <div>
              <h3>{c.t}</h3>
              <p class="muted" set:html={code(c.d)} />
            </div>
          </div>
        ))}
        <Terminal title="exit 3" class="reveal guard-term" html={guardTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ DOCS -->
<section id="docs" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="docs-band reveal">
      <div>
        <p class="eyebrow">{s.docsCta.eyebrow}</p>
        <h2>{s.docsCta.title}</h2>
        <p class="lead">{s.docsCta.teaser}</p>
      </div>
      <a class="btn btn-primary" href={docsHref}>{s.docsCta.cta} →</a>
    </div>
  </div>
</section>

<!-- ============================================================ FAQ -->
<section id="faq" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <p class="eyebrow reveal">{s.faq.eyebrow}</p>
    <div class="faq">
      {s.faq.items.map((it) => (
        <details class="reveal">
          <summary>{it.q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ CTA -->
<section class="cta">
  <div class="rails cta-inner">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="cta-head">
    <MaskedHeading
      client:load
      tag="h2"
      text={s.cta.title}
      src="/mask.svg"
      align="center"
      weight={700}
      tracking={-0.04}
      lineHeight={1.02}
      textScale={0.09}
      reveal="rise"
      trigger="view"
      parallax={18}
      drift={12}
      className="cta-title"
    />
    </div>
    <p class="lead center">{s.cta.sub}</p>
    <a href={REPO} class="btn btn-brand" target="_blank" rel="noopener">{s.cta.button} →</a>
  </div>
</section>

<style>
  /* hero */
  .hero {
    border-top: 0;
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 75% -10%, rgba(0, 168, 255, 0.14), transparent 60%),
      radial-gradient(600px 400px at 10% 110%, rgba(30, 64, 216, 0.12), transparent 60%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 128px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  :global(.hero-title) {
    margin: 0 0 24px !important;
    width: 100%;
  }
  .hero-copy {
    min-width: 0;
    max-width: 640px;
  }
  .hero-term {
    min-width: 0;
  }
  .cmd {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 8px 8px 8px 14px;
  }
  .cmd code {
    font-size: 12.5px;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .chat-link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }
  .chat-link:hover {
    color: var(--brand);
  }
  .chat-link .arrow {
    transition: transform 0.18s ease;
  }
  .chat-link:hover .arrow {
    transform: translateX(3px);
  }
  .chat-dots {
    display: inline-flex;
    gap: 3px;
  }
  .chat-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--brand);
    animation: chat-blink 1.4s infinite ease-in-out;
  }
  .chat-dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .chat-dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes chat-blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-dots i {
      animation: none;
      opacity: 1;
    }
  }
  .hero-term {
    transform: perspective(1400px) rotateY(-4deg);
    transition: transform 0.6s ease;
  }
  .hero-term:hover {
    transform: perspective(1400px) rotateY(0deg);
  }
  @media (max-width: 980px) {
    .hero-term {
      transform: none;
    }
  }

  /* trust */
  .trust-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 800px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .works-label {
    margin: 18px 0 0;
  }
  .stat {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .agent {
    transition: background 0.2s ease;
  }
  .agent:hover {
    background: var(--bg-raised);
  }
  .agent-icon {
    width: 34px;
    height: 34px;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .agent-name {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .tab-icon {
    width: 18px;
    height: 18px;
  }
  .lbl {
    font-size: 14px;
    color: var(--fg-muted);
  }

  /* affiliate */
  .affiliate {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(700px 340px at 82% 0%, rgba(0, 168, 255, 0.12), transparent 62%);
  }
  .aff-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: clamp(28px, 4vw, 44px);
    margin-block: clamp(56px, 7vw, 88px);
  }
  @media (max-width: 900px) {
    .aff-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .aff-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .aff-bg img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 78% 45%;
    opacity: 0.9;
  }
  .aff-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(520px 300px at 6% 30%, rgba(0, 168, 255, 0.16), transparent 70%),
      linear-gradient(180deg, rgba(14, 14, 18, 0.55) 0%, rgba(14, 14, 18, 0) 22%, rgba(14, 14, 18, 0) 78%, rgba(14, 14, 18, 0.6) 100%),
      linear-gradient(
        90deg,
        rgb(14, 14, 18) 0%,
        rgba(14, 14, 18, 0.97) 40%,
        rgba(14, 14, 18, 0.86) 58%,
        rgba(14, 14, 18, 0.6) 78%,
        rgba(14, 14, 18, 0.34) 100%
      );
  }
  @media (max-width: 900px) {
    .aff-bg img {
      object-position: 68% 40%;
      opacity: 0.7;
    }
    .aff-bg::after {
      background:
        linear-gradient(180deg, rgba(14, 14, 18, 0.92) 0%, rgba(14, 14, 18, 0.86) 45%, rgba(14, 14, 18, 0.96) 100%);
    }
  }
  .aff-title {
    margin: 14px 0 0;
    font-size: clamp(28px, 3.4vw, 42px);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .aff-card .lead {
    margin-top: 14px;
    max-width: 62ch;
  }
  .aff-stats {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }
  @media (max-width: 620px) {
    .aff-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .aff-stats li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .aff-v {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--brand);
  }
  .aff-stats .lbl {
    font-size: 12px;
    line-height: 1.35;
  }
  .aff-action {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(10, 10, 12, 0.62);
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
  }
  @supports not (backdrop-filter: blur(4px)) {
    .aff-action {
      background: rgba(10, 10, 12, 0.9);
    }
  }
  .aff-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    justify-content: center;
  }
  /* a light stroke travelling around the perimeter — the button colour never changes */
  .aff-btn::before {
    content: "";
    position: absolute;
    z-index: -2;
    top: 50%;
    left: 50%;
    width: 200%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background:
      conic-gradient(
        from 0deg,
        transparent 0deg,
        rgba(255, 255, 255, 0) 4deg,
        rgba(214, 240, 255, 0.9) 10deg,
        rgba(255, 255, 255, 1) 14deg,
        rgba(214, 240, 255, 0.9) 18deg,
        rgba(255, 255, 255, 0) 24deg,
        transparent 180deg,
        rgba(255, 255, 255, 0) 184deg,
        rgba(214, 240, 255, 0.6) 190deg,
        rgba(255, 255, 255, 0.75) 194deg,
        rgba(214, 240, 255, 0.6) 198deg,
        rgba(255, 255, 255, 0) 204deg,
        transparent 360deg
      ),
      linear-gradient(rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.16));
    animation: aff-orbit 3.6s linear infinite;
  }
  .aff-btn::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 2px;
    border-radius: calc(var(--radius) - 1px);
    background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  }
  .aff-btn:hover {
    filter: none;
  }
  @keyframes aff-orbit {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aff-btn::before {
      animation: none;
      opacity: 0.5;
    }
  }
  .aff-note {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--fg-muted);
    text-align: center;
  }

  /* why */
  .why-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1040px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  /* install */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step p {
    margin: 6px 0 14px;
    font-size: 15px;
  }
  .step code:not(pre code) {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  /* tabs (shared) */
  .tablist {
    display: flex;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .tablist button {
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--line);
    color: var(--fg-muted);
    font: 500 13.5px var(--font-sans);
    padding: 14px 20px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tablist button[aria-selected="true"] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--brand);
  }

  /* tutorials */
  .tutorials {
    background:
      radial-gradient(700px 360px at 90% 0%, rgba(0, 168, 255, 0.08), transparent 60%),
      var(--bg);
  }
  .small {
    font-size: 14px;
    margin: 14px 0 0;
  }
  .small code {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .agent-tabs {
    margin-top: 40px;
    border: 1px solid var(--line);
    background: var(--bg-card);
  }
  .agent-tabs .tablist button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    padding: 16px 24px;
  }
  .agent-panel[hidden] {
    display: none;
  }
  .agent-panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 0;
  }
  @media (max-width: 900px) {
    .agent-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .tut-steps {
    list-style: none;
    margin: 0;
    padding: 28px 28px 28px 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 18px;
