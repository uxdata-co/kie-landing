---
/**
 * "I'm an Agent" / "I'm a Human" switch for the hero.
 *
 * An agent that lands here should not have to read a marketing page to find
 * out how to use the tool. The agent tab hands it one line to copy — a prompt
 * that points at /skill.md, which is a complete operating guide. The human tab
 * is the install command it replaced.
 *
 * The choice is remembered in localStorage. Rendering starts on the agent tab
 * and a blocking inline script switches it before paint if the visitor already
 * chose "human", so there is no flash of the wrong panel.
 */
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).audience;
const installCmd = "npm i -g @uxdata-co/kie";
const agentPrompt = "Read https://kiecli.com/skill.md";
/** `backticks` -> <code>, matching how the rest of the landing renders copy. */
const code = (x: string) => x.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<div class="audience" data-audience>
  <div class="switch" role="tablist" aria-label={s.label}>
    <button
      type="button"
      role="tab"
      class="tab"
      data-tab="agent"
      id="aud-tab-agent"
      aria-controls="aud-panel-agent"
      aria-selected="true"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="8" width="16" height="12" rx="3"></rect>
        <path d="M12 8V4"></path><circle cx="12" cy="3" r="1.4" fill="currentColor"></circle>
        <path d="M2 13v3M22 13v3"></path>
        <circle cx="9" cy="13.5" r="1.15" fill="currentColor" stroke="none"></circle>
        <circle cx="15" cy="13.5" r="1.15" fill="currentColor" stroke="none"></circle>
      </svg>
      <span>{s.agent}</span>
    </button>
    <button
      type="button"
      role="tab"
      class="tab"
      data-tab="human"
      id="aud-tab-human"
      aria-controls="aud-panel-human"
      aria-selected="false"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="8" r="3.6"></circle>
        <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
      </svg>
      <span>{s.human}</span>
    </button>
  </div>

  <div class="panel" id="aud-panel-agent" role="tabpanel" aria-labelledby="aud-tab-agent" data-panel="agent">
    <p class="hint">{s.agentHint}</p>
    <div class="cmd">
      <code><span class="kw">Read</span> {agentPrompt.slice(5)}</code>
      <button class="copy" data-copy={agentPrompt} data-copied={s.copied} type="button" aria-label={s.copy}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2"></rect>
          <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
        </svg>
      </button>
    </div>
    <p class="sub" set:html={code(s.agentSub)} />
  </div>

  <div class="panel" id="aud-panel-human" role="tabpanel" aria-labelledby="aud-tab-human" data-panel="human" hidden>
    <p class="hint">{s.humanHint}</p>
    <div class="cmd">
      <code><span class="dollar">$</span> {installCmd}</code>
      <button class="copy" data-copy={installCmd} data-copied={s.copied} type="button" aria-label={s.copy}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2"></rect>
          <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
        </svg>
      </button>
    </div>
    <p class="sub" set:html={code(s.humanSub)} />
  </div>
</div>

<script is:inline>
  // Runs before paint: restore a remembered choice without a visible flip.
  (function () {
    try {
      if (localStorage.getItem("kie-audience") !== "human") return;
      var root = document.currentScript.previousElementSibling;
      if (!root) return;
      root.querySelectorAll("[data-tab]").forEach(function (b) {
        b.setAttribute("aria-selected", String(b.dataset.tab === "human"));
      });
      root.querySelectorAll("[data-panel]").forEach(function (p) {
        p.hidden = p.dataset.panel !== "human";
      });
    } catch (e) {
      /* private mode: keep the default */
    }
  })();
</script>

<script>
  document.querySelectorAll<HTMLElement>("[data-audience]").forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-panel]");

    const select = (name: string) => {
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === name)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
      try {
        localStorage.setItem("kie-audience", name);
      } catch {
        /* private mode: the choice just does not persist */
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.dataset.tab!));
      // Arrow keys move between tabs, per the WAI-ARIA tabs pattern.
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next.dataset.tab!);
      });
    });
  });
</script>

<style>
  .audience {
    margin-top: 36px;
    max-width: 460px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-card);
    padding: 8px;
  }
  .switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 7px;
    padding: 4px;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--fg-dim);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .tab:hover {
    color: var(--fg-muted);
  }
  .tab[aria-selected="true"] {
    background: var(--bg-raised);
    border-color: var(--line);
    color: var(--fg);
  }
  .tab:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .panel {
    padding: 14px 6px 4px;
  }
  .panel[hidden] {
    display: none;
  }
  .hint {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--fg-muted);
    text-align: center;
  }
  .sub {
    margin: 9px 0 4px;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--fg-dim);
    text-align: center;
  }
  .sub :global(code) {
    color: var(--fg-muted);
    font-size: 11px;
  }

  .cmd {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(0, 0, 0, 0.35);
    padding: 9px 8px 9px 12px;
  }
  .cmd code {
    flex: 1;
    min-width: 0;
    font-size: 12.5px;
    color: var(--fg);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cmd code::-webkit-scrollbar {
    display: none;
  }
  .kw {
    color: var(--warn);
  }
  .dollar {
    color: var(--fg-dim);
  }
  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .copy:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--line);
  }
  .copy:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  .copy.done {
    color: var(--ok);
  }

  @media (max-width: 480px) {
    .audience {
      max-width: 100%;
    }
    .tab span {
      font-size: 12.5px;
    }
  }
</style>
